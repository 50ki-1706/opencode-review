{
  "name": "opencode-review",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-reporter=spec test/",
    "build": "node scripts/build.mjs",
    "build:verify": "node scripts/check-bundle.mjs determinism",
    "bundle:check": "node scripts/check-bundle.mjs size"
  },
  "dependencies": {
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.8.2",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    }
  }
}
